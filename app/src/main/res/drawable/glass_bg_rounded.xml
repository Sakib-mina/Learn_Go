<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="50dp" />
            <solid android:color="#2000E5FF" /> </shape>
    </item>

    <item android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp">
        <shape>
            <corners android:radius="50dp" />
            <gradient
                android:startColor="#0A1931"
                android:centerColor="#061225"
                android:endColor="#0A1931"
                android:angle="0" />
            <stroke
                android:width="1.2dp"
                android:color="#9900E5FF" />
        </shape>
    </item>
</layer-list>