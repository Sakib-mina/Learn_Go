<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="24dp" />
            <solid android:color="#1A00E5FF" /> </shape>
    </item>

    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape>
            <corners android:radius="22dp" />
            <stroke
                android:width="2.5dp"
                android:color="#4D00E5FF" /> </shape>
    </item>

    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape>
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#26FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#1AFFFFFF"
                android:angle="135" />
            <stroke
                android:width="1.2dp"
                android:color="#B300E5FF" /> </shape>
    </item>
</layer-list>