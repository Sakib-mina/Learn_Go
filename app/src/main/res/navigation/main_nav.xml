<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.novamindlabs.learngo.ui.views.dashboard.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_quizTestFragment"
            app:destination="@id/quizTestFragment" />
    </fragment>
    <fragment
        android:id="@+id/quizFragment"
        android:name="com.novamindlabs.learngo.ui.views.dashboard.QuizFragment"
        android:label="fragment_quiz"
        tools:layout="@layout/fragment_quiz" >
        <action
            android:id="@+id/action_quizFragment_to_quizTestFragment"
            app:destination="@id/quizTestFragment" />
    </fragment>
    <fragment
        android:id="@+id/walletFragment"
        android:name="com.novamindlabs.learngo.ui.views.dashboard.WalletFragment"
        android:label="fragment_wallet"
        tools:layout="@layout/fragment_wallet" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.novamindlabs.learngo.ui.views.dashboard.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_supportFragment"
            app:destination="@id/supportFragment" />
    </fragment>
    <fragment
        android:id="@+id/quizTestFragment"
        android:name="com.novamindlabs.learngo.ui.views.dashboard.QuizTestFragment"
        android:label="fragment_quiz_test"
        tools:layout="@layout/fragment_quiz_test" >
        <action
            android:id="@+id/action_quizTestFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_quizTestFragment_to_resultFragment"
            app:destination="@id/resultFragment" />
    </fragment>
    <fragment
        android:id="@+id/resultFragment"
        android:name="com.novamindlabs.learngo.ui.views.dashboard.ResultFragment"
        android:label="fragment_result"
        tools:layout="@layout/fragment_result" >
        <action
            android:id="@+id/action_resultFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/supportFragment"
        android:name="com.novamindlabs.learngo.ui.views.support.SupportFragment"
        android:label="fragment_support"
        tools:layout="@layout/fragment_support" >
        <action
            android:id="@+id/action_supportFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
</navigation>